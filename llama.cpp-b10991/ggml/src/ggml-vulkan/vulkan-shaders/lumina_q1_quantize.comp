#version 450
// Lumina: quantise the F32 activations of a MUL_MAT to int8 with ONE scale per 128 values
// (the Q8_128 format of the CPU q1t path). Output keeps ggml's [n][k] layout.

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

layout(local_size_x = 128) in;

layout(push_constant) uniform params { uint K; uint N; uint nb; } p;

layout(std430, binding = 0) readonly  buffer B  { float  bf[]; }; // [N][K] f32
layout(std430, binding = 1) writeonly buffer BQ { int8_t bq[]; }; // [K][N] int8 (transposed for the GEMM)
layout(std430, binding = 2) writeonly buffer BS { float  bs[]; }; // [N][nb]
#ifdef LUMINA_Q1_Q8_AXSUM
// Per-128 sum of the *quantised* values, used by the GEMV path's dot(a,w) = 2*dot(a,bits) - sum(a)
// identity (the CPU q1t trick). Only the single-column (GEMV) variant asks for it.
layout(std430, binding = 3) writeonly buffer AX { float  ax[]; }; // [N][nb]
#endif

shared float red[128];
#ifdef LUMINA_Q1_Q8_AXSUM
shared int   ired[128];
#endif

void main() {
    const uint ib  = gl_WorkGroupID.x;
    const uint col = gl_WorkGroupID.y;
    const uint t   = gl_LocalInvocationID.x;

    const uint idx = col * p.K + ib * 128u + t;
    const float v  = bf[idx];

    red[t] = abs(v);
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (t < s) { red[t] = max(red[t], red[t + s]); }
        barrier();
    }
    const float amax = red[0];
    const float d    = amax / 127.0;
    const float id   = amax != 0.0 ? 127.0 / amax : 0.0;

    int q = int(round(v * id));
    q = clamp(q, -127, 127);
    // store transposed ([K][N]) so the GEMM's activation staging is coalesced
    bq[(ib * 128u + t) * p.N + col] = int8_t(q);
    if (t == 0u) { bs[col * p.nb + ib] = d; }
#ifdef LUMINA_Q1_Q8_AXSUM
    ired[t] = q;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (t < s) { ired[t] += ired[t + s]; }
        barrier();
    }
    if (t == 0u) { ax[col * p.nb + ib] = float(ired[0]); }
#endif
}
