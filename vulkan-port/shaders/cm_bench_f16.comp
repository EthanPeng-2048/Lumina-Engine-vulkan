#version 460
// Raw cooperative-matrix (tensor core) throughput: f16 x f16 -> f32.
// Config from the device probe: M=16 N=16 K=16, FLOAT16/FLOAT16/FLOAT32.

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 32) in;

layout(push_constant) uniform P { uint iters; } p;

shared float16_t sa[16 * 16];
shared float16_t sb[16 * 16];
shared float     sc[16 * 16];

layout(std430, binding = 0) writeonly buffer D { float odata[]; };

void main() {
    const uint t = gl_LocalInvocationID.x;
    for (uint i = t; i < 16u * 16u; i += 32u) { sa[i] = float16_t(1.0); }
    for (uint i = t; i < 16u * 16u; i += 32u) { sb[i] = float16_t(1.0); }
    barrier();

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> A;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B;
    coopmat<float,     gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> C =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    coopMatLoad(A, sa, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(B, sb, 0, 16, gl_CooperativeMatrixLayoutRowMajor);

    for (uint i = 0u; i < p.iters; ++i) {
        C = coopMatMulAdd(A, B, C);
    }

    coopMatStore(C, sc, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    if (t == 0u) { odata[gl_WorkGroupID.x] = sc[0]; }
}
